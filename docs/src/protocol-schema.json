      "description": "Where a tool call stands.",
      "oneOf": [
        {
          "const": "inProgress",
          "description": "Waiting or running.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "It ran and did what was asked.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "It ran and failed: bad arguments, an error, a timeout, or a command\nthat exited non-zero.",
          "type": "string"
        },
        {
          "const": "declined",
          "description": "It never ran: refused at an approval, by plan mode or by a\nsub-agent's limits.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "The turn stopped before or while it ran.",
          "type": "string"
        }
      ]
    },
