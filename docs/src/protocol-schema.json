{
  "$defs": {
    "ApprovalDecision": {
      "description": "Yes or no to a tool call.",
      "oneOf": [
        {
          "description": "Run it.",
          "properties": {
            "type": {
              "const": "approve",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Run it, and the same command or file again this session.",
          "properties": {
            "type": {
              "const": "approveForSession",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Don't run it.",
          "properties": {
            "type": {
              "const": "reject",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Don't run it, and tell the model why.",
          "properties": {
            "feedback": {
              "description": "What the model is told.",
              "type": "string"
            },
            "type": {
              "const": "rejectWithFeedback",
              "type": "string"
            }
          },
          "required": [
            "type",
            "feedback"
          ],
          "type": "object"
        }
      ]
    },
    "ClientInfo": {
      "description": "A client's name and version, such as `koda-cli` `0.7.0`.",
      "properties": {
        "name": {
          "description": "The client's name.",
          "type": "string"
        },
        "version": {
          "description": "The client's version.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "CompactionStatus": {
      "description": "Where a compaction stands.",
      "oneOf": [
        {
          "const": "inProgress",
          "description": "Summarizing.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "History was replaced.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "A precondition stopped it; nothing changed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The summary call failed; nothing changed.",
          "type": "string"
        }
      ]
    },
    "CompactionTrigger": {
      "description": "What set off a compaction.",
      "oneOf": [
        {
          "const": "threshold",
          "description": "Context passed the auto-compact threshold before a model call.",
          "type": "string"
        },
        {
          "const": "overflow",
          "description": "The provider rejected a request as too long.",
          "type": "string"
        },
        {
          "const": "window",
          "description": "The estimate was past the window, so history was dropped unsummarized.",
          "type": "string"
        },
        {
          "const": "idle",
          "description": "A session idle long enough had its old tool results cleared.",
          "type": "string"
        }
      ]
    },
    "ErrorNotification": {
      "description": "`error`.",
      "properties": {
        "error": {
          "$ref": "#/$defs/TurnError",
          "description": "What went wrong."
        },
        "retry": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retry"
            },
            {
              "type": "null"
            }
          ],
          "description": "The retry, when there is one."
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        },
        "turnId": {
          "description": "The turn, when it happened in one.",
          "type": [
            "string",
            "null"
          ]
        },
        "willRetry": {
          "description": "Whether Koda will try again. The turn goes on if so.",
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "error",
        "willRetry"
      ],
      "type": "object"
    },
    "ErrorObject": {
      "description": "What went wrong with a request.",
      "properties": {
        "code": {
          "description": "One of the codes in [`codes`], or a Koda code.",
          "format": "int64",
          "type": "integer"
        },
        "data": {
          "description": "Detail for a program, if any."
        },
        "message": {
          "description": "One sentence for a person.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "The answer to a request that failed.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject",
          "description": "What went wrong."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The request's id; `null` when it couldn't be read."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        }
      },
      "required": [
        "jsonrpc",
        "error"
      ],
      "type": "object"
    },
    "ExecSummary": {
      "description": "`exec/summary`: the run as a whole. Only `koda exec` sends it, last.",
      "properties": {
        "durationMs": {
          "description": "Wall-clock time of the run.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "error": {
          "description": "Why it failed.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "The model.",
          "type": "string"
        },
        "provider": {
          "description": "The provider.",
          "type": "string"
        },
        "response": {
          "description": "The last reply.",
          "type": "string"
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        },
        "subAgentToolCalls": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Sub-agents' tool calls, by tool.",
          "type": "object"
        },
        "success": {
          "description": "Whether the run succeeded. An interrupted turn is not a failure.",
          "type": "boolean"
        },
        "toolCalls": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "description": "The agent's own tool calls, by tool.",
          "type": "object"
        },
        "turnStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnStatus"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the turn ended; `None` if it never did."
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "description": "Everything stored for the session, sub-agents and the earlier turns\nof a resumed session included."
        },
        "usageByAgent": {
          "additionalProperties": {
            "$ref": "#/$defs/Usage"
          },
          "description": "`usage` by agent. The session's own calls are under `main`.",
          "type": "object"
        }
      },
      "required": [
        "sessionId",
        "success",
        "provider",
        "model",
        "response",
        "durationMs",
        "usage",
        "usageByAgent",
        "toolCalls",
        "subAgentToolCalls"
      ],
      "type": "object"
    },
    "InitializeParams": {
      "description": "The client says who it is.",
      "properties": {
        "clientInfo": {
          "$ref": "#/$defs/ClientInfo",
          "description": "The client's name and version."
        }
      },
      "required": [
        "clientInfo"
      ],
      "type": "object"
    },
    "InitializeResponse": {
      "description": "The server says what it is and which protocol it speaks.",
      "properties": {
        "protocolVersion": {
          "description": "[`crate::PROTOCOL_VERSION`] of the server.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "serverInfo": {
          "$ref": "#/$defs/ServerInfo",
          "description": "Koda's name and version."
        }
      },
      "required": [
        "serverInfo",
        "protocolVersion"
      ],
      "type": "object"
    },
    "Item": {
      "description": "A part of a turn.",
      "oneOf": [
        {
          "description": "What the user said: a turn's prompt, or steering text added while it\nran, as the model received it. Steering texts that reached the model\ntogether are one item.",
          "properties": {
            "clientMessageIds": {
              "description": "The client's ids for the messages it carries, where it gave them.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "id": {
              "description": "The item's id.",
              "type": "string"
            },
            "text": {
              "description": "The text.",
              "type": "string"
            },
            "type": {
              "const": "userMessage",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text",
            "clientMessageIds"
          ],
          "type": "object"
        },
        {
          "description": "Text from the model. Complete text on `item/completed`.",
          "properties": {
            "id": {
              "description": "The item's id.",
              "type": "string"
            },
            "text": {
              "description": "The text so far: empty when it starts.",
              "type": "string"
            },
            "type": {
              "const": "agentMessage",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "The model's reasoning, where the provider shows it.",
          "properties": {
            "id": {
              "description": "The item's id.",
              "type": "string"
            },
            "text": {
              "description": "The text so far: empty when it starts.",
              "type": "string"
            },
            "type": {
              "const": "reasoning",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ],
          "type": "object"
        },
        {
          "description": "A tool call.",
          "properties": {
            "arguments": {
              "description": "The arguments the model gave."
            },
            "detail": {
              "description": "What the call would do, in a line, when Koda asked about it or\nblocked it.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "The call's id, from the model.",
              "type": "string"
            },
            "output": {
              "description": "What the model reads: the tool's output, or why it didn't run.\nSet on completion.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/ToolCallStatus",
              "description": "Where it stands."
            },
            "tool": {
              "description": "The tool, such as `Bash` or `Edit`.",
              "type": "string"
            },
            "type": {
              "const": "toolCall",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "tool",
            "arguments",
            "status"
          ],
          "type": "object"
        },
        {
          "description": "Context compaction: old history summarized or dropped to make room.",
          "properties": {
            "contextPercent": {
              "description": "Context used when it began, in percent, where it was measured.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "id": {
              "description": "The item's id.",
              "type": "string"
            },
            "messagesRemoved": {
              "description": "Rows taken out of the context, when completed.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "reason": {
              "description": "Why it was skipped or failed.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/CompactionStatus",
              "description": "Where it stands."
            },
            "summaryTokens": {
              "description": "Estimated size of the summary, when there is one.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "trigger": {
              "$ref": "#/$defs/CompactionTrigger",
              "description": "What set it off."
            },
            "type": {
              "const": "contextCompaction",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "trigger",
            "status"
          ],
          "type": "object"
        }
      ]
    },
    "ItemCompletedNotification": {
      "description": "`item/completed`. Every item that starts completes.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Item",
          "description": "The item, complete."
        },
        "parentItemId": {
          "description": "On a sub-agent's items: the tool call that started the sub-agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        },
        "turnId": {
          "description": "The turn.",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "item"
      ],
      "type": "object"
    },
    "ItemStartedNotification": {
      "description": "`item/started`.",
      "properties": {
        "item": {
          "$ref": "#/$defs/Item",
          "description": "The item as it starts."
        },
        "parentItemId": {
          "description": "On a sub-agent's items: the tool call that started the sub-agent.",
          "type": [
            "string",
            "null"
          ]
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        },
        "turnId": {
          "description": "The turn.",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "item"
      ],
      "type": "object"
    },
    "JsonRpcVersion": {
      "const": "2.0",
      "type": "string"
    },
    "LoopCapDecision": {
      "description": "Whether a turn at its cap goes on.",
      "oneOf": [
        {
          "const": "continue50",
          "description": "50 more iterations.",
          "type": "string"
        },
        {
          "const": "continue200",
          "description": "200 more iterations.",
          "type": "string"
        },
        {
          "const": "stop",
          "description": "Stop the turn.",
          "type": "string"
        }
      ]
    },
    "LoopCapParams": {
      "description": "`turn/loopCap/requestDecision`: the turn reached its iteration cap.\nUntil it is answered the turn waits.",
      "properties": {
        "cap": {
          "description": "The cap.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "recentTools": {
          "description": "The tools called most recently.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        },
        "turnId": {
          "description": "The turn.",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "turnId",
        "cap",
        "recentTools"
      ],
      "type": "object"
    },
    "LoopCapResponse": {
      "description": "The answer to `turn/loopCap/requestDecision`.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/LoopCapDecision",
          "description": "Go on or stop."
        }
      },
      "required": [
        "decision"
      ],
      "type": "object"
    },
    "LoopGuardAction": {
      "description": "What the loop guard did.",
      "oneOf": [
        {
          "const": "feedback",
          "description": "Told the model to change course; the turn goes on.",
          "type": "string"
        },
        {
          "const": "stop",
          "description": "The model didn't, so the turn stops.",
          "type": "string"
        }
      ]
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request",
          "description": "A call that expects a response."
        },
        {
          "$ref": "#/$defs/Notification",
          "description": "A one-way message."
        },
        {
          "$ref": "#/$defs/Response",
          "description": "A successful response."
        },
        {
          "$ref": "#/$defs/ErrorResponse",
          "description": "A failed response."
        }
      ],
      "description": "Any message on the wire, in either direction.\n\nThe variants are told apart by their members, as the specification\ndoes: a request has `id` and `method`, a notification `method` only, a\nresponse `result`, an error `error`."
    },
    "Notification": {
      "additionalProperties": false,
      "description": "A one-way message: nothing answers it.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "The notification's name.",
          "type": "string"
        },
        "params": {
          "description": "Its parameters."
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "OutputStream": {
      "description": "A command's output stream.",
      "oneOf": [
        {
          "const": "stdout",
          "description": "Standard output.",
          "type": "string"
        },
        {
          "const": "stderr",
          "description": "Standard error.",
          "type": "string"
        }
      ]
    },
    "PlanStep": {
      "description": "One step of a plan.",
      "properties": {
        "status": {
          "$ref": "#/$defs/PlanStepStatus",
          "description": "How far it got."
        },
        "step": {
          "description": "What the step is.",
          "type": "string"
        }
      },
      "required": [
        "step",
        "status"
      ],
      "type": "object"
    },
    "PlanStepStatus": {
      "description": "How far a plan step got.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Not started.",
          "type": "string"
        },
        {
          "const": "inProgress",
          "description": "Being worked on.",
          "type": "string"
        },
        {
          "const": "completed",
          "description": "Done.",
          "type": "string"
        }
      ]
    },
    "Request": {
      "additionalProperties": false,
      "description": "A call that expects a [`Response`] or an [`ErrorResponse`] with the same id.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "Echoed in the response."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "The method name, such as `state/read`.",
          "type": "string"
        },
        "params": {
          "description": "The method's parameters."
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "description": "A numeric id. Koda's own clients use these.",
          "format": "int64",
          "type": "integer"
        },
        {
          "description": "A string id.",
          "type": "string"
        }
      ],
      "description": "A request id, chosen by whoever sends the request."
    },
    "Response": {
      "additionalProperties": false,
      "description": "The result of a request that succeeded.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "The request's id."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "result": {
          "description": "The method's response."
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "type": "object"
    },
    "Retry": {
      "description": "A model call that will be tried again.",
      "properties": {
        "attempt": {
          "description": "The attempt that failed, counting from 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "delayMs": {
          "description": "The wait before the next one.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "maxAttempts": {
          "description": "The attempts the call gets in all.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reason": {
          "$ref": "#/$defs/RetryReason",
          "description": "Why."
        }
      },
      "required": [
        "reason",
        "attempt",
        "maxAttempts",
        "delayMs"
      ],
      "type": "object"
    },
    "RetryReason": {
      "description": "Why a model call is tried again.",
      "oneOf": [
        {
          "const": "rateLimit",
          "description": "The provider said to slow down.",
          "type": "string"
        },
        {
          "const": "network",
          "description": "A connection failed or timed out.",
          "type": "string"
        },
        {
          "const": "serverError",
          "description": "The provider answered with a server error.",
          "type": "string"
        },
        {
          "const": "streamFailed",
          "description": "The reply's stream failed partway; what it had shown is discarded.",
          "type": "string"
        },
        {
          "const": "contextOverflow",
          "description": "The context was too long; it was compacted first.",
          "type": "string"
        },
        {
          "const": "emptyResponse",
          "description": "The model returned nothing.",
          "type": "string"
        }
      ]
    },
    "SandboxState": {
      "description": "The sandbox commands run in.",
      "properties": {
        "available": {
          "description": "Whether it works on this machine. Auto mode needs it.",
          "type": "boolean"
        },
        "backend": {
          "description": "The backend: `seatbelt`, `bwrap` or `none`.",
          "type": "string"
        },
        "reason": {
          "description": "Why not, when it doesn't.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "backend",
        "available"
      ],
      "type": "object"
    },
    "ServerInfo": {
      "description": "Koda's name and version.",
      "properties": {
        "name": {
          "description": "Always `koda`.",
          "type": "string"
        },
        "version": {
          "description": "The Koda release, such as `0.6.4`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "ServerRequestResolvedNotification": {
      "description": "`serverRequest/resolved`: a request needs no answer any more. Other\nclients dismiss their prompt. In `koda exec`, Koda answers its own\nrequests and sends this right after each.",
      "properties": {
        "requestId": {
          "$ref": "#/$defs/RequestId",
          "description": "The request."
        },
        "sessionId": {
          "description": "The session.",
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "requestId"
      ],
      "type": "object"
    },
    "Session": {
      "description": "A session as it starts.",
      "properties": {
        "contextWindow": {
          "description": "The context window in tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "The session's id, for resuming it.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/TrustMode",
          "description": "What Koda may do without asking."
        },
        "model": {
          "description": "The model id, such as `claude-sonnet-5-5`.",
          "type": "string"
        },
        "provider": {
