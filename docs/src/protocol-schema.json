      "description": "What a tool call does, and so whether it needs a yes.",
      "oneOf": [
        {
          "const": "readOnly",
          "description": "Reads only.",
          "type": "string"
        },
        {
          "const": "remoteAction",
          "description": "Acts on a remote service.",
          "type": "string"
        },
        {
          "const": "localMutation",
          "description": "Changes local files or state.",
          "type": "string"
        },
        {
          "const": "destructive",
          "description": "Irreversible or far-reaching: `rm -rf`, `git push --force`.",
          "type": "string"
